[resource]
script = ExtResource("5_tvs8h")
npc_id = "rine"
display_name = "청과상 리네"
sprite = ExtResource("6_m0wsn")
difficulty = 2
level = 3
day_lines = PackedStringArray("어서 와요. 오늘 사과는 강 건너 과수원에서 새벽에 실어 온 거예요.", "광장 분수 물이 요즘 탁해졌다는 말이 돌아요. 위쪽 수로에 뭔가 있는 거겠죠.")
night_lines = PackedStringArray("이 시간까지 좌판을 접지 못했네요. 남은 걸 다 팔아야 방값이 나와서요.", "밤엔 골목 쪽으로 돌아가지 마세요. 등불이 죄다 꺼져 있거든요.")
pass_actions = Array[ExtResource("1_m3j4i")]([SubResource("Resource_kb438"), SubResource("Resource_ocije"), SubResource("Resource_vhywi")])
