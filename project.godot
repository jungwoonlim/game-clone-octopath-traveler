; Godot 프로젝트 설정
; 에디터로 열지 않고 CLI로 개발하므로 이 파일을 직접 편집한다.

config_version=5

[application]

config/name="Octopath Clone"
config/description="Godot 4.7 HD-2D JRPG 프로토타입"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/core/game_state.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
DayNight="*res://scripts/core/day_night.gd"

[input]

; 게임플레이 입력은 커스텀 액션, UI 내비게이션은 Godot 기본 ui_* 로 완전히 분리한다.
; ui_accept/ui_left 등을 게임플레이에 그대로 쓰면, 포커스를 가진 Control이 같은 입력을
; 함께 소비해서 "대사 넘김 + 버튼 눌림", "메뉴 커서 이동 + 캐릭터 걸음"이 동시에 일어난다.
; 이 이중 반응은 나중에 원인을 찾기가 매우 어렵다. ui_* 기본 바인딩은 손대지 않는다.
;
; WASD는 physical_keycode로 등록한다. keycode로 등록하면 AZERTY·드보락 배열에서 엉뚱한 키가 걸린다.
; 방향키·Space·Enter처럼 위치가 고정된 키는 keycode로 둔다.
;
; 게임패드 인덱스는 Godot 4.7.2에서 실측한 값이다 (A=0 B=1 Y=3 START=6 DPAD U/D/L/R=11~14).

