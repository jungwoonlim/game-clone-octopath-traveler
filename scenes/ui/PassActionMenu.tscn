[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/pass_action_menu.gd" id="1_menu"]

; 폰트 설정 근거는 DialogueBox.tscn의 주석 참고 (640×360 렌더 → 2배 확대라 AA를 끈다).
[sub_resource type="SystemFont" id="SystemFont_kr"]
font_names = PackedStringArray("Apple SD Gothic Neo")
antialiasing = 0
subpixel_positioning = 0
hinting = 2

[sub_resource type="SystemFont" id="SystemFont_kr_bold"]
font_names = PackedStringArray("Apple SD Gothic Neo")
antialiasing = 0
subpixel_positioning = 0
hinting = 2
font_weight = 700

; 대화창과 같은 재질이어야 한 세트로 보인다. 알파만 0.02 높다 —
; 목록은 지금 조작해야 하는 대상이라 대사보다 조금 더 또렷해야 한다.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_menu"]
bg_color = Color(0.055, 0.06, 0.1, 0.86)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.84, 0.77, 0.56, 0.95)
corner_detail = 1
anti_aliasing = false
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 4
shadow_offset = Vector2(0, 2)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_inset"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.02, 0.02, 0.04, 0.55)
corner_detail = 1
anti_aliasing = false

; 대화창(layer=20)과 같은 층에 둔다. PostFX 비네팅이 layer=10이라 그 아래면 모서리가 어둡다.
[node name="PassActionMenu" type="CanvasLayer"]
layer = 20
script = ExtResource("1_menu")
item_font = SubResource("SystemFont_kr")

[node name="Root" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; 640×360 좌표계. 오른쪽 위(x 480~624)에 붙이고 **아랫변(y 236)을 고정**한 채
; 항목 수만큼 위로 자란다 — 항목이 1개일 때 아래가 빈 판으로 남지 않는다.
; 실제 offset_top은 pass_action_menu.gd가 계산한다. 여기 적힌 157은 2개짜리 기준값이다.
; 대화창 이름표 윗변이 y 246이므로 10px 여유가 있다. 이 값을 내리면 겹침을 직접 확인할 것.
[node name="Panel" type="Panel" parent="Root"]
offset_left = 480.0
offset_top = 157.0
offset_right = 624.0
offset_bottom = 236.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_menu")

[node name="Inset" type="Panel" parent="Root/Panel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 1.0
offset_top = 1.0
offset_right = -1.0
offset_bottom = -1.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_inset")

; 제목은 12px. 항목(13px)보다 작아야 "무슨 목록인가"가 아니라 "무엇을 고를까"에 시선이 간다.
; 11px도 시도했지만 AA를 끈 상태에서 한글 받침이 뭉개졌다(_screenshots/ui_menu_zoom.png). 12px이 하한이다.
[node name="Title" type="Label" parent="Root/Panel"]
anchor_right = 1.0
offset_left = 10.0
offset_top = 5.0
offset_right = -10.0
offset_bottom = 21.0
mouse_filter = 2
text = "패스 액션"
theme_override_colors/font_color = Color(0.95, 0.85, 0.55, 1)
theme_override_fonts/font = SubResource("SystemFont_kr_bold")
theme_override_font_sizes/font_size = 12

; 제목과 항목을 가르는 1px 선. 없으면 제목이 첫 번째 항목처럼 읽혀 커서를 찾게 된다.
[node name="Rule" type="ColorRect" parent="Root/Panel"]
anchor_right = 1.0
offset_left = 10.0
offset_top = 23.0
offset_right = -10.0
offset_bottom = 24.0
mouse_filter = 2
color = Color(0.84, 0.77, 0.56, 0.35)

[node name="Items" type="VBoxContainer" parent="Root/Panel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 32.0
offset_right = -8.0
offset_bottom = -8.0
mouse_filter = 2
theme_override_constants/separation = 1
